# ---------------------------------------------------------------------------
# GloAro WhatsApp Bot - environment configuration
# Copy to .env and fill in. NEVER commit .env.
# In AWS these values come from Secrets Manager / SSM Parameter Store.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Public base URL of this backend (used to build the webhook URL you give Meta)
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local docker-compose maps postgres to host port 5433
DATABASE_URL=postgresql://gloaro:gloaro_dev_password@localhost:5433/gloaro_bot?schema=public

# --- Redis (BullMQ queues: sheets sync, admin notify) -----------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Seeded first admin user (npm run db:seed)
ADMIN_EMAIL=admin@gloaro.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=GloAro Admin

# --- WhatsApp ---------------------------------------------------------------
# There are NO provider credentials here. Each client configures its own
# provider (UltraMsg / Gupshup / AiSensy / 360dialog), number and credentials
# from Admin Dashboard > Settings > WhatsApp. Those values are encrypted with
# the key below before they are written to the database.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Changing it makes every stored credential unreadable,
# so rotate it deliberately and re-enter the credentials afterwards.
CREDENTIALS_ENCRYPTION_KEY=

# Admin lead-notification numbers are per client too, under
# Settings > Admin notifications.

# --- Google Sheets ----------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Path to the service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
# Alternative to the file (used in AWS): the whole JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- 360dialog Sandbox ------------------------------------------------------
# Set these to provision the existing GloAro WhatsApp integration from env.
# The API key is encrypted into PostgreSQL and never sent to the frontend.
DIALOG360_API_KEY=
DIALOG360_PHONE_NUMBER=
DIALOG360_CHANNEL_ID=
DIALOG360_ENVIRONMENT=sandbox

# --- Bot behaviour ----------------------------------------------------------
# Minutes of inactivity before a conversation restarts at the welcome message
BOT_SESSION_TIMEOUT_MINUTES=30

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
