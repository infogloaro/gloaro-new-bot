// GloAro WhatsApp Bot - database schema
//
// Multi-tenant, multi-provider.
//   Tenant -> WhatsAppProviderConfig (one per provider/number the client uses)
//   Tenant -> Customer -> Conversation -> Message
//   Tenant -> Customer -> Lead
//
// Every row a client can see carries `tenantId`. Uniqueness that used to be
// global is scoped to the tenant, because two clients may legitimately talk to
// the same customer number and may use the same bot node keys and setting keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  CLOSED
}

/// Top-level branch the lead came from.
enum MainCategory {
  GLOARO_MART
  DIGITAL_NETWORK
}

enum ConversationStatus {
  ACTIVE
  IDLE
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Delivery state of the two side effects a new lead triggers.
enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  UNROUTED
}

/// Supported WhatsApp gateways. Meta Cloud API is deliberately absent - it is
/// added as one more value plus one more adapter when the time comes, with no
/// change to the bot engine.
enum WhatsAppProviderType {
  ULTRAMSG
  GUPSHUP
  AISENSY
  DIALOG360
}

/// Live state of one tenant's WhatsApp channel, as shown in the admin panel.
enum ProviderConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

// ---------------------------------------------------------------------------
// Tenants
// ---------------------------------------------------------------------------

/// One GloAro client. Owns its own WhatsApp channel, bot flow, settings,
/// customers and leads. Nothing crosses this boundary.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  /// URL/log-friendly identifier, e.g. "gloaro" or "acme-foods".
  slug String @unique
  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  customers       Customer[]
  leads           Lead[]
  conversations   Conversation[]
  messages        Message[]
  botFlows        BotFlow[]
  botSessions     BotSession[]
  settings        Setting[]
  webhookEvents   WebhookEvent[]
  leadCounters    LeadCounter[]
  providerConfigs WhatsAppProviderConfig[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// WhatsApp channel configuration
// ---------------------------------------------------------------------------

/// One row per (tenant, provider, number). `credentials` holds the vendor's
/// fields, each value individually encrypted with AES-256-GCM - the plaintext
/// never reaches the database, the logs or the browser.
model WhatsAppProviderConfig {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider WhatsAppProviderType
  /// Business WhatsApp number, digits only, international format.
  phoneNumber String @map("phone_number")
  /// Free-text name shown in the admin panel, e.g. "Sales line".
  label       String @default("WhatsApp")

  /// The provider-side account identifier used to route inbound webhooks when
  /// the callback URL carries no account id: UltraMsg instance id, Gupshup app
  /// name, 360dialog channel id.
  externalId String? @map("external_id")

  /// { fieldName: encryptedValue }. Shape is defined by the provider descriptor.
  credentials Json @default("{}")

  /// Encrypted shared secret. Appended to the callback URL as ?token= and/or
  /// compared against the provider's signature header.
  webhookSecret String @map("webhook_secret")
  /// The exact URL the client must paste into the provider's dashboard.
  webhookUrl    String @map("webhook_url")

  status        ProviderConnectionStatus @default(PENDING)
  /// Last connection-test or send outcome, safe to display. Never a credential.
  statusMessage String?                  @map("status_message") @db.Text
  lastCheckedAt DateTime?                @map("last_checked_at")
  /// Set the first time a webhook for this account is successfully processed.
  lastInboundAt DateTime?                @map("last_inbound_at")

  /// Master switch for the bot on this channel.
  isActive Boolean @default(false) @map("is_active")
  /// The channel outbound messages use when the caller does not name one.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@unique([tenantId, provider, phoneNumber])
  @@unique([provider, externalId])
  @@index([tenantId, isActive])
  @@index([phoneNumber])
  @@map("whatsapp_provider_configs")
}

// ---------------------------------------------------------------------------
// Admin panel users
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  /// NULL for SUPER_ADMIN, who operates across every tenant. Every other role
  /// is pinned to exactly one tenant and can never read outside it.
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assignedLeads        Lead[]         @relation("LeadAssignee")
  leadNotes            LeadNote[]
  handledConversations Conversation[] @relation("ConversationAgent")

  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers (one row per WhatsApp number per tenant)
// ---------------------------------------------------------------------------

model Customer {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// International format, digits only, no '+'. e.g. 919876543210
  whatsappNumber   String   @map("whatsapp_number")
  /// Display name the provider reports for this contact.
  profileName      String?  @map("profile_name")
  name             String?
  email            String?
  businessName     String?  @map("business_name")
  businessCategory String?  @map("business_category")
  city             String?

  lastInteractionAt DateTime @default(now()) @map("last_interaction_at")
  isBlocked         Boolean  @default(false) @map("is_blocked")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  leads         Lead[]
  conversations Conversation[]
  messages      Message[]
  session       BotSession?

  @@unique([tenantId, whatsappNumber])
  @@index([tenantId, lastInteractionAt])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Human-readable reference, unique within the tenant. e.g. GL-2026-000123
  leadRef String @map("lead_ref")

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  whatsappNumber  String       @map("whatsapp_number")
  name            String?
  email           String?
  businessName    String?      @map("business_name")
  mainCategory    MainCategory @map("main_category")
  /// e.g. B2B_MARKETPLACE, BECOME_SELLER, MEMBERSHIP, FRANCHISE, JOIN, EVENT_REGISTER
  subCategory     String       @map("sub_category")
  /// Product category (Mart) or business category (Network) chosen by the customer.
  productCategory String?      @map("product_category")
  city            String?
  requirement     String?      @db.Text

  status     LeadStatus @default(NEW)
  assignedTo String?    @map("assigned_to") @db.Uuid
  assignee   User?      @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  /// Everything the bot collected, verbatim, including fields not promoted to columns.
  rawAnswers Json? @map("raw_answers")

  sheetSyncStatus SyncStatus @default(PENDING) @map("sheet_sync_status")
  sheetSyncedAt   DateTime?  @map("sheet_synced_at")
  sheetSyncError  String?    @map("sheet_sync_error") @db.Text
  /// 1-based row the lead landed on in the Google Sheet, for later status updates.
  sheetRowNumber  Int?       @map("sheet_row_number")

  notifySyncStatus SyncStatus @default(PENDING) @map("notify_sync_status")
  notifiedAt       DateTime?  @map("notified_at")
  notifyError      String?    @map("notify_error") @db.Text

  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes LeadNote[]

  @@unique([tenantId, leadRef])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, whatsappNumber])
  @@index([mainCategory, subCategory])
  @@index([sheetSyncStatus])
  @@map("leads")
}

model LeadNote {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_notes")
}

// ---------------------------------------------------------------------------
// Conversations & messages
// ---------------------------------------------------------------------------

model Conversation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status       ConversationStatus @default(ACTIVE)
  /// Agent who took the conversation over from the bot, if any.
  agentId      String?            @map("agent_id") @db.Uuid
  agent        User?              @relation("ConversationAgent", fields: [agentId], references: [id], onDelete: SetNull)
  /// True while a human agent is handling it - the bot stays silent.
  isHandedOver Boolean            @default(false) @map("is_handed_over")

  startedAt     DateTime  @default(now()) @map("started_at")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  closedAt      DateTime? @map("closed_at")
  messageCount  Int       @default(0) @map("message_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]
  leads    Lead[]

  @@index([tenantId, lastMessageAt])
  @@index([customerId])
  @@index([tenantId, status])
  @@map("conversations")
}

model Message {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     String       @map("customer_id") @db.Uuid
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  direction MessageDirection
  /// text | interactive | button | image | document | audio | video | location | template | unsupported
  type      String           @default("text")
  body      String?          @db.Text

  /// Which gateway carried this message. NULL only for simulator/dry-run rows.
  provider         WhatsAppProviderType?   @map("provider")
  providerConfigId String?                 @map("provider_config_id") @db.Uuid
  providerConfig   WhatsAppProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)

  /// The provider's own message id. Only unique *within* a provider, hence the
  /// composite constraint - two vendors can and do mint the same id string.
  providerMessageId String? @map("provider_message_id")

  status       MessageStatus @default(PENDING)
  errorMessage String?       @map("error_message") @db.Text

  /// Full provider payload for this message, kept for debugging.
  payload Json?
  /// Bot flow node this message was sent from / answered against.
  botNode String? @map("bot_node")

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Bot engine
// ---------------------------------------------------------------------------

/// One row per node of the conversation tree. Editable from the Bot Menu screen
/// so copy changes do not need a redeploy. Each tenant has its own tree.
model BotFlow {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Stable node key referenced by the engine, e.g. MAIN_MENU, MART_B2B_CATEGORY
  key String

  name     String
  /// MENU | MESSAGE | QUESTION | ACTION
  nodeType String  @map("node_type")
  /// Message body sent to the customer. Supports {{placeholders}}.
  body     String  @db.Text
  /// Optional media sent with the body.
  imageUrl String? @map("image_url")
  linkUrl  String? @map("link_url")

  /// MENU nodes: [{ key, label, next, emoji?, description?, menuTitle? }]
  options Json?
  /// MENU nodes: label on the button that opens the tappable list.
  menuButton String? @map("menu_button")
  /// QUESTION nodes: which lead field this answer fills + validation rule.
  fieldName  String? @map("field_name")
  /// text | name | email | phone | city | pincode | orderid | longtext
  fieldType  String? @map("field_type")
  isRequired Boolean @default(true) @map("is_required")
  /// Node to go to when this one completes.
  nextKey    String? @map("next_key")
  /// ACTION nodes: CREATE_LEAD | TRACK_ORDER | END
  action     String?
  /// For CREATE_LEAD: which category the resulting lead is tagged with.
  mainCategory MainCategory? @map("main_category")
  subCategory  String?       @map("sub_category")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("bot_flows")
}

/// Live position of one customer inside the flow. One row per customer.
model BotSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String   @unique @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Current BotFlow.key the customer is sitting on.
  currentNode  String @default("WELCOME") @map("current_node")
  /// Answers gathered so far in this run, keyed by BotFlow.fieldName.
  data         Json   @default("{}")
  /// Nodes visited, newest last - used for the "back"/"menu" commands.
  history      Json   @default("[]")
  /// Consecutive unrecognised replies. Resets to 0 on a valid answer.
  invalidCount Int    @default(0) @map("invalid_count")

  expiresAt     DateTime @map("expires_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([tenantId])
  @@map("bot_sessions")
}

// ---------------------------------------------------------------------------
// Settings (key/value, editable from the Settings screen)
// ---------------------------------------------------------------------------

model Setting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key   String
  value String @db.Text
  /// company | whatsapp | notification | sheets | bot
  group String @default("company")
  label String
  /// string | number | boolean | json | secret
  type  String @default("string")
  /// Secrets are masked in API responses.
  isSecret Boolean @default(false) @map("is_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId, group])
  @@map("settings")
}

// ---------------------------------------------------------------------------
// Webhook idempotency log
// ---------------------------------------------------------------------------

/// Every inbound provider message id is recorded here before processing. The
/// composite unique constraint is what makes redelivery a no-op instead of a
/// duplicate reply and a duplicate lead. It is scoped by provider because
/// message ids are only unique within one vendor.
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  /// NULL when the payload could not be routed to a tenant - kept for forensics.
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider          WhatsAppProviderType
  providerMessageId String               @map("provider_message_id")

  /// message | status | unknown
  eventType    String             @default("message") @map("event_type")
  fromNumber   String?            @map("from_number")
  status       WebhookEventStatus @default(RECEIVED)
  payload      Json
  errorMessage String?            @map("error_message") @db.Text
  attempts     Int                @default(0)
  processedAt  DateTime?          @map("processed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([provider, providerMessageId])
  @@index([tenantId, createdAt])
  @@index([status])
  @@map("webhook_events")
}

/// Sequence helper for generating leadRef values (GL-YYYY-NNNNNN), per tenant.
model LeadCounter {
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year     Int
  value    Int    @default(0)

  @@id([tenantId, year])
  @@map("lead_counters")
}
